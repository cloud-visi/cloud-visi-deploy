{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "replicaCount",
    "secrets"
  ],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "secrets": {
      "type": "object",
      "required": [
        "existingSecret"
      ],
      "properties": {
        "existingSecret": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "backfillDays": {
          "type": "integer",
          "minimum": 1
        },
        "pollInterval": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "image": {
      "type": "object",
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        }
      }
    }
  }
}
